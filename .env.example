# Скопіюйте в .env. Реальні значення в репозиторій не потрапляють.
POSTGRES_USER=scitracker
POSTGRES_PASSWORD=scitracker
POSTGRES_DB=scitracker
DB_PORT=5433
DATABASE_URL=postgresql+psycopg://scitracker:scitracker@127.0.0.1:5433/scitracker?connect_timeout=5
TEST_DATABASE_URL=postgresql+psycopg://scitracker:scitracker@127.0.0.1:5433/scitracker_test?connect_timeout=5
CROSSREF_MAILTO=your_email@example.com
# Згенеруйте: python -c "import secrets; print(secrets.token_urlsafe(48))" (мінімум 32 символи)
JWT_SECRET=
LOG_LEVEL=INFO
# json for servers, text for local development
LOG_FORMAT=text
